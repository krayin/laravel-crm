# ==============================================================================
# STAGING/PRODUCTION ENVIRONMENT - Theme System Ready
# ==============================================================================
# Copie este arquivo para .env e ajuste os valores

APP_NAME="Krayin CRM"
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging.seu-dominio.com

# ==============================================================================
# DATABASE - MySQL/PostgreSQL recomendado
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=krayin_staging
DB_USERNAME=krayin_user
DB_PASSWORD=sua_senha_segura
DB_PREFIX=

# ==============================================================================
# CACHE - Redis OBRIGATÓRIO para sistema de temas
# ==============================================================================
# IMPORTANTE: file driver causa "tema não muda" em ambientes com múltiplas instâncias
CACHE_DRIVER=redis

# ==============================================================================
# SESSION - Redis recomendado (Preview usa session)
# ==============================================================================
# IMPORTANTE: Preview isolado por sessão - Redis garante consistência
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# ==============================================================================
# QUEUE - Redis para operações assíncronas futuras
# ==============================================================================
QUEUE_CONNECTION=redis

# ==============================================================================
# REDIS
# ==============================================================================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis

# Prefixos para evitar colisão entre ambientes
REDIS_PREFIX=krayin_staging_
CACHE_PREFIX=krayin_staging_cache_

# ==============================================================================
# FILESYSTEM
# ==============================================================================
FILESYSTEM_DISK=public

# Para múltiplas instâncias (load balancer), usar S3:
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=krayin-themes

# ==============================================================================
# LOGGING
# ==============================================================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ==============================================================================
# MAIL (para notificações de erro)
# ==============================================================================
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
