# Copy this file to .env and fill values before running docker compose

### Application
APP_NAME=LaravelCRM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

### Vite / Frontend
VITE_HOST=0.0.0.0
VITE_PORT=5173
ASSET_URL=

### Database (MySQL example)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

### MySQL root (used by mysql container setup)
MYSQL_ROOT_PASSWORD=root

### Cache / Queue / Session (Redis)
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

### Mail
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Laravel CRM"

### AWS / Storage (if using S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=

### Third party / push / pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

### IMAP (if inbound email processing used)
IMAP_DEFAULT_ACCOUNT=
IMAP_HOST=
IMAP_PORT=
IMAP_PROTOCOL=imap
IMAP_ENCRYPTION=ssl
IMAP_USERNAME=
IMAP_PASSWORD=

### Composer / private repo auth (if needed)
COMPOSER_AUTH={}