{
    "name": "webkul/theme-manager",
    "description": "ThemeManager - Sistema completo de personalização visual do Krayin CRM",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Webkul",
            "email": "support@webkul.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Webkul\\ThemeManager\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webkul\\ThemeManager\\Providers\\ThemeManagerServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
