{
    "name": "webkul/theme-manager",
    "description": "Visual customization package for Krayin CRM - Custom themes, logos, colors, and login page styling",
    "version": "1.0.0",
    "type": "library",
    "keywords": [
        "krayin",
        "crm",
        "theme",
        "customization",
        "branding",
        "laravel"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Webkul",
            "email": "support@webkul.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Webkul\\ThemeManager\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webkul\\ThemeManager\\Providers\\ThemeManagerServiceProvider",
                "Webkul\\ThemeManager\\Providers\\ModuleServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
