# =============================================================================
# Krayin CRM - Docker Swarm Environment Configuration
# =============================================================================
# Copy this file to .env.swarm and edit with your values:
#   cp .env.swarm.example .env.swarm
#   nano .env.swarm
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME="Krayin CRM"
APP_ENV=production
APP_DEBUG=false
APP_VERSION=latest

# IMPORTANT: Generate with: php artisan key:generate --show
APP_KEY=base64:GENERATE_ME_WITH_ARTISAN_KEY_GENERATE

# Your domain (without https://)
APP_DOMAIN=crm.yourdomain.com

# Admin panel path (default: admin)
ADMIN_PATH=admin

# -----------------------------------------------------------------------------
# Database (MySQL 8.0)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=krayin
DB_USERNAME=krayin

# IMPORTANT: Use a strong password!
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD_HERE

# -----------------------------------------------------------------------------
# Redis (Cache, Sessions, Queues)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Cache settings
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# -----------------------------------------------------------------------------
# SSL/TLS (Let's Encrypt via Traefik)
# -----------------------------------------------------------------------------
ACME_EMAIL=admin@yourdomain.com

# -----------------------------------------------------------------------------
# Traefik Dashboard (Optional)
# -----------------------------------------------------------------------------
# Generate password hash with: htpasswd -nb admin yourpassword
# Escape $ as $$ in the hash
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$xyz$$CHANGE_ME

# -----------------------------------------------------------------------------
# Docker Registry (Optional - for private images)
# -----------------------------------------------------------------------------
DOCKER_REGISTRY=

# -----------------------------------------------------------------------------
# Scaling Configuration
# -----------------------------------------------------------------------------
APP_REPLICAS=2
NGINX_REPLICAS=2
QUEUE_REPLICAS=2

# -----------------------------------------------------------------------------
# Resource Limits
# -----------------------------------------------------------------------------
# App container
APP_CPU_LIMIT=1.0
APP_MEMORY_LIMIT=1G
APP_CPU_RESERVATION=0.25
APP_MEMORY_RESERVATION=256M

# MySQL container
MYSQL_CPU_LIMIT=2.0
MYSQL_MEMORY_LIMIT=4G
MYSQL_CPU_RESERVATION=0.5
MYSQL_MEMORY_RESERVATION=1G

# Redis container
REDIS_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=512M
REDIS_MAX_MEMORY=384mb

# -----------------------------------------------------------------------------
# Mail Settings (Optional)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.yourdomain.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Storage Paths (on host machine)
# -----------------------------------------------------------------------------
# These directories will be created automatically
DATA_PATH=/data/krayin
MYSQL_DATA_PATH=${DATA_PATH}/mysql
STORAGE_PATH=${DATA_PATH}/storage
BACKUP_PATH=${DATA_PATH}/backups
