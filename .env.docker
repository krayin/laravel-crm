# =============================================================================
# Krayin CRM - Docker Environment Template
# Copy this file to .env and customize for your environment
# =============================================================================

APP_NAME='Krayin CRM'
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.example.com
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_CURRENCY=USD

# Logging
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=krayin
DB_USERNAME=krayin
DB_PASSWORD=your_secure_password_here
DB_PREFIX=

# Cache & Session (use Redis for multi-container setup)
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Docker specific
RUN_MIGRATIONS=false
DOCKER_REGISTRY=
APP_VERSION=latest
APP_DOMAIN=crm.example.com

# Traefik (optional)
ACME_EMAIL=admin@example.com
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$xyz

# AWS (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
