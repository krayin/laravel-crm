
includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app
        - packages

    level: 5

    ignoreErrors:
        # Publishable config template, copied into config/ by vendor:publish, where env() is expected.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: packages/Webkul/Core/src/Config/cors.php

    bootstrapFiles:
        - vendor/autoload.php

    excludePaths:
        analyse:
            - vendor
            - storage
            - bootstrap/cache
            # Unused legacy base class; its astrotomic/laravel-translatable dependency is not installed.
            - packages/Webkul/Core/src/Eloquent/TranslatableModel.php
